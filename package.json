    },
    "./object": {
      "types": "./object/index.d.ts",
      "import": "./object/index.js"
    },
    "./object/deep-partial": {
      "types": "./object/deep-partial.d.ts",
      "import": "./object/deep-partial.js"
    },
    "./object/has-own": {
      "types": "./object/has-own.d.ts",
      "import": "./object/has-own.js"
    },
    "./object/json": {
      "types": "./object/json.d.ts",
      "import": "./object/json.js"
