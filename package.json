{
  "name": "@l5i/ts-util",
  "version": "0.0.0-semantic-release",
  "description": "A collection of general-purpose TypeScript utilities.",
  "license": "MIT",
  "author": "Lorelei Aurora <iam@l5i.me> (https://l5i.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoreleiAurora/ts-util.git"
  },
  "homepage": "https://github.com/LoreleiAurora/ts-util",
  "bugs": {
    "url": "https://github.com/LoreleiAurora/ts-util/issues"
  },
  "type": "module",
  "exports": {
    "./array": {
      "types": "./array/index.d.ts",
      "import": "./array/index.js"
    },
    "./array/chunk": {
      "types": "./array/chunk.d.ts",
      "import": "./array/chunk.js"
    },
    "./array/types": {
      "types": "./array/types.d.ts",
      "import": "./array/types.js"
    },
    "./array/unique": {
      "types": "./array/unique.d.ts",
      "import": "./array/unique.js"
    },
    "./async": {
      "types": "./async/index.d.ts",
      "import": "./async/index.js"
    },
    "./async/abort": {
      "types": "./async/abort.d.ts",
      "import": "./async/abort.js"
    },
    "./async/linear-backoff": {
      "types": "./async/linear-backoff.d.ts",
      "import": "./async/linear-backoff.js"
    },
    "./async/retry": {
      "types": "./async/retry.d.ts",
      "import": "./async/retry.js"
    },
    "./async/sleep": {
      "types": "./async/sleep.d.ts",
      "import": "./async/sleep.js"
    },
    "./async/types": {
      "types": "./async/types.d.ts",
      "import": "./async/types.js"
    },
    "./async/with-timeout": {
      "types": "./async/with-timeout.d.ts",
      "import": "./async/with-timeout.js"
    },
    "./function": {
      "types": "./function/index.d.ts",
      "import": "./function/index.js"
    },
    "./function/debounce": {
      "types": "./function/debounce.d.ts",
      "import": "./function/debounce.js"
    },
    "./function/throttle": {
      "types": "./function/throttle.d.ts",
      "import": "./function/throttle.js"
