    "./function/types": {
      "types": "./function/types.d.ts",
      "import": "./function/types.js"
    },
    "./guards": {
      "types": "./guards/index.d.ts",
      "import": "./guards/index.js"
    },
    "./guards/is-defined": {
      "types": "./guards/is-defined.d.ts",
      "import": "./guards/is-defined.js"
    },
    "./guards/is-object": {
